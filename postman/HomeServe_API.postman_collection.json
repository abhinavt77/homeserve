            },
            "url": {
              "raw": "{{baseUrl}}/customer/payments/verify/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "payments", "verify", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "3. Settle with Cash (Instant Settlement)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/payments/cash/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "payments", "cash", "{{bookingId}}"]
            }
          }
        }
      ]
