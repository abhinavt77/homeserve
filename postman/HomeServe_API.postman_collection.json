    {
      "name": "5. Booking & Dispatch Flow",
      "item": [
        {
          "name": "1. Customer Create Booking (PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.trackingNumber) {",
                  "        pm.collectionVariables.set('trackingNumber', jsonData.data.trackingNumber);",
                  "    }",
                  "    if (jsonData.data.id) {",
                  "        pm.collectionVariables.set('bookingId', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"addressId\": 1,\n  \"description\": \"Main switch tripping continuously in master bedroom\",\n  \"scheduledAt\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customer/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "bookings"]
            }
          }
        },
        {
          "name": "2. Track Booking Live (By Tracking #)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/bookings/track/{{trackingNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "bookings", "track", "{{trackingNumber}}"]
            }
          }
        },
        {
          "name": "3. Provider Check Nearby Available Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/provider/jobs/available",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "jobs", "available"]
            }
          }
        },
        {
          "name": "4. Provider Accept Job (Optimistic Locking Winner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/provider/jobs/{{bookingId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "jobs", "{{bookingId}}", "accept"]
            }
          }
        },
        {
          "name": "5. Provider Update Status: ON_THE_WAY",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ON_THE_WAY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/provider/jobs/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "jobs", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "6. Provider Update Status: IN_PROGRESS",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/provider/jobs/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "jobs", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "7. Provider Complete Job (Sets Final Cost)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
