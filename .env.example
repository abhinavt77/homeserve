# ==========================================
# HomeServe Environment Configuration
# ==========================================

# Application Port
SERVER_PORT=8080
FRONTEND_PORT=5173

# Database Configuration (PostgreSQL with PostGIS / Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homeservedb
DB_USER=homeserve_user
DB_PASSWORD=homeserve_pass
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT Secret & Expiration (Minimum 256 bits for HS256 / HS384 / HS512)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Razorpay Test Credentials (for real testing replace with your key id and secret from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_homeserveKeyId123
RAZORPAY_KEY_SECRET=homeserveRazorpaySecretMock456
RAZORPAY_CURRENCY=INR

# Cloudinary Credentials (for document and profile image uploads)
CLOUDINARY_CLOUD_NAME=homeserve-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=homeserve_cloudinary_secret_sample

# Email Notifications (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@homeserve.com

# Service Matching Radius Defaults (in Kilometers)
MATCHING_INITIAL_RADIUS_KM=15.0
MATCHING_EXPANDED_RADIUS_KM=35.0
MATCHING_TIMEOUT_MINUTES=5
